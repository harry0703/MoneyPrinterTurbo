{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MoneyPrinterTurbo",
  "version": "1.3.8",
  "identifier": "com.mpt.desktop",
  "mainBinaryName": "MoneyPrinterTurbo",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MoneyPrinterTurbo",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": {
      "resources/mpt-server": "mpt-server",
      "resources/ffmpeg": "ffmpeg"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
