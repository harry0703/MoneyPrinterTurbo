# Claude Code variant image: installs the claude CLI on top of the official release image.
#
# Claude subscriptions (Pro / Max / Team) don't issue API Keys, and only the official Claude Code client
# can use subscription credentials, so the `claude_code` Provider depends on an executable claude
# CLI inside the container. The release image is reused here, avoiding reinstalling Python dependencies.
FROM ghcr.io/harry0703/moneyprinterturbo:latest

# The CLI version is pinned, so behavior doesn't drift when the image is rebuilt; change the version number here to upgrade.
ARG CLAUDE_CODE_VERSION=2.1.260
ARG NODE_MAJOR=22

# The claude CLI is distributed via npm and the release image has no Node.js, so the NodeSource repository is added first.
RUN set -eu; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl gnupg; \
    curl -fsSL "https://deb.nodesource.com/setup_${NODE_MAJOR}.x" | bash -; \
    apt-get install -y --no-install-recommends nodejs; \
    npm install -g "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}"; \
    npm cache clean --force; \
    apt-get purge -y gnupg; \
    apt-get autoremove -y; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*; \
    claude --version
