{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MoneyPrinterTurbo",
  "identifier": "io.github.harry0703.moneyprinterturbo",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
